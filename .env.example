# Copy to .env (never commit the real .env — it's in .gitignore). Anything
# here can also be set as a real environment variable instead, e.g. in your
# crontab or systemd unit, using the same QARA_REG_SCRAPER_* names.

# --- qara-reg-scraper-svc (optional; manifests always work without it) ---
# Owns the Postgres index and exposes the REST API `run`/`reindex`/`status`
# upsert to / read from — this CLI never talks to Postgres directly.
QARA_REG_SCRAPER_SERVICE__BASE_URL=http://localhost:8080/api/reg-scraper

# --- S3 storage backend (if storage.backend: s3) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_PROFILE=some-named-profile   # alternative to explicit keys

# --- Azure Blob storage backend (if storage.backend: azure_blob) ---
# Either a connection string...
AZURE_STORAGE_CONNECTION_STRING=
# ...or, with storage.azure_blob.account_url set in config.yaml, rely on
# DefaultAzureCredential (managed identity / az login) and leave this unset.

# --- SharePoint storage backend (if storage.backend: sharepoint) ---
# App-only auth (client credentials flow) — do NOT use a personal password.
QARA_REG_SCRAPER_SHAREPOINT_CLIENT_SECRET=

# --- Override any config.yaml value without editing the file ---
# QARA_REG_SCRAPER_STORAGE__BACKEND=s3
# QARA_REG_SCRAPER_HTTP__REQUESTS_PER_SECOND=0.5
# QARA_REG_SCRAPER_LOG_LEVEL=DEBUG
# QARA_REG_SCRAPER_MAX_NEW_DOCUMENTS_PER_RUN=10
